  {id:"green",bg:"#4ADE80",light:"rgba(74,222,128,0.15)",dark:"#16A34A"},
  {id:"indigo",bg:"#818CF8",light:"rgba(129,140,248,0.15)",dark:"#4338CA"},
];
const FONTS=[
  {id:"nunito",name:"Nunito",sample:"The quick brown fox",css:"'Nunito', sans-serif"},
  {id:"system",name:"Mặc định",sample:"The quick brown fox",css:"-apple-system, BlinkMacSystemFont, sans-serif"},
  {id:"serif",name:"Serif",sample:"The quick brown fox",css:"Georgia, 'Times New Roman', serif"},
  {id:"mono",name:"Monospace",sample:"The quick brown fox",css:"'Courier New', Courier, monospace"},
];
function loadSettings() { try{return JSON.parse(localStorage.getItem("appSettings")||"{}");}catch(e){return{};} }
function saveSettings(s) { localStorage.setItem("appSettings",JSON.stringify(s)); }
function applySettings() {
  const s=loadSettings();
  const theme=THEMES.find(t=>t.id===(s.theme||"dark"))||THEMES[0];
  const accent=ACCENTS.find(a=>a.id===(s.accent||"teal"))||ACCENTS[0];
  const font=FONTS.find(f=>f.id===(s.font||"nunito"))||FONTS[0];
  const root=document.documentElement;
  root.style.setProperty("--bg",theme.bg); root.style.setProperty("--card",theme.card);
  root.style.setProperty("--text",theme.text); root.style.setProperty("--muted",theme.muted);
  root.style.setProperty("--accent",accent.bg); root.style.setProperty("--accent-l",accent.light); root.style.setProperty("--accent-d",accent.dark);
  root.style.setProperty("--teal",accent.bg); root.style.setProperty("--teal-l",accent.light); root.style.setProperty("--teal-d",accent.dark);
  root.style.setProperty("--font",font.css); document.body.style.fontFamily=font.css;
  ["anim","phonetic","askResume"].forEach(k=>{ const val=s[k]!==false; const el=document.getElementById("toggle"+k.charAt(0).toUpperCase()+k.slice(1)); if(el) el.classList.toggle("on",val); });
}
function renderSettingsPage() {
  const s=loadSettings();
  document.getElementById("themeGrid").innerHTML=THEMES.map(t=>`<button class="theme-btn${(s.theme||"dark")===t.id?" selected":""}" onclick="setTheme('${t.id}')" style="background:${t.bg}"><div class="theme-preview" style="background:${t.card}"><div style="width:40%;height:8px;border-radius:4px;background:${t.text};opacity:.7"></div><div style="width:20%;height:8px;border-radius:4px;background:#00D4AA"></div></div><div class="theme-name" style="color:${t.text}">${t.name}</div></button>`).join("");
  document.getElementById("accentGrid").innerHTML=ACCENTS.map(a=>`<button class="accent-btn${(s.accent||"teal")===a.id?" selected":""}" style="background:${a.bg}" onclick="setAccent('${a.id}')"></button>`).join("");
  document.getElementById("fontGrid").innerHTML=FONTS.map(f=>`<button class="font-btn${(s.font||"nunito")===f.id?" selected":""}" onclick="setFont('${f.id}')"><div class="font-name" style="font-family:${f.css}">${f.name}</div><div class="font-sample" style="font-family:${f.css}">${f.sample}</div></button>`).join("");
  ["anim","phonetic","askResume"].forEach(k=>{ const val=s[k]!==false; const el=document.getElementById("toggle"+k.charAt(0).toUpperCase()+k.slice(1)); if(el) el.classList.toggle("on",val); });
}
function setTheme(id){const s=loadSettings();s.theme=id;saveSettings(s);applySettings();renderSettingsPage();showToast("✓ Đã đổi giao diện");}
function setAccent(id){const s=loadSettings();s.accent=id;saveSettings(s);applySettings();renderSettingsPage();showToast("✓ Đã đổi màu chủ đạo");}
function setFont(id){const s=loadSettings();s.font=id;saveSettings(s);applySettings();renderSettingsPage();showToast("✓ Đã đổi font chữ");}
function toggleSetting(key){const s=loadSettings();s[key]=s[key]===false?true:false;saveSettings(s);applySettings();showToast("✓ Đã lưu");}

// ── Splash ──
