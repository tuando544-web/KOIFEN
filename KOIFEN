// ── Confetti ──
function launchCelebration(allKnown) {
  const el=document.getElementById("celebration"); el.innerHTML="";
  const colors=["#1D9E75","#7F77DD","#378ADD","#D4537E","#E0920A","#D85A30","#639922","#fff"];
  for(let i=0;i<80;i++){
    const p=document.createElement("div"); p.className="confetti-piece";
    const c=colors[Math.floor(Math.random()*colors.length)];
    const sz=6+Math.random()*10; const x=Math.random()*100;
    const dur=1.5+Math.random()*2; const delay=Math.random()*1.2;
    const shape=Math.random()>.5?"50%":Math.random()>.5?"2px":"50% 0";
    p.style.cssText=`left:${x}vw;top:-20px;width:${sz}px;height:${sz}px;background:${c};border-radius:${shape};animation-duration:${dur}s;animation-delay:${delay}s;`;
    el.appendChild(p);
  }
  if(allKnown){ for(let b=0;b<5;b++) setTimeout(()=>launchBurst(el,20+Math.random()*60,15+Math.random()*50,colors),b*300); }
  setTimeout(()=>{el.innerHTML="";},4000);
}
function launchBurst(el,cx,cy,colors) {
  for(let i=0;i<16;i++){
    const d=document.createElement("div"); d.className="firework";
    const angle=(i/16)*Math.PI*2; const dist=40+Math.random()*60;
    const tx=Math.cos(angle)*dist; const ty=Math.sin(angle)*dist;
    const c=colors[Math.floor(Math.random()*colors.length)];
    d.style.cssText=`left:${cx}vw;top:${cy}vh;background:${c};width:${4+Math.random()*6}px;height:${4+Math.random()*6}px;transform:translate(${tx}px,${ty}px);animation:fireworkBurst .8s ${Math.random()*.2}s ease-out both;`;
    el.appendChild(d);
  }
}

