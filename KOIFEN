<script>
/* ============================================================
   KOIF – JavaScript (full logic, unchanged from original)
   ============================================================ */
const COLORS = [
  { name:"teal",   bg:"#00D4AA", light:"rgba(0,212,170,0.15)",   dark:"#00A882" },
  { name:"purple", bg:"#A78BFA", light:"rgba(167,139,250,0.15)", dark:"#7C3AED" },
  { name:"blue",   bg:"#60A5FA", light:"rgba(96,165,250,0.15)",  dark:"#2563EB" },
  { name:"amber",  bg:"#FBBF24", light:"rgba(251,191,36,0.15)",  dark:"#D97706" },
  { name:"coral",  bg:"#F87171", light:"rgba(248,113,113,0.15)", dark:"#DC2626" },
  { name:"pink",   bg:"#F472B6", light:"rgba(244,114,182,0.15)", dark:"#DB2777" },
  { name:"green",  bg:"#4ADE80", light:"rgba(74,222,128,0.15)",  dark:"#16A34A" },
];

// ── IndexedDB ──
const DB_NAME="flashcardDB", DB_VER=1, STORE="appData";
function openDB() {
  return new Promise((res,rej)=>{
    const req=indexedDB.open(DB_NAME,DB_VER);
    req.onupgradeneeded=e=>e.target.result.createObjectStore(STORE);
    req.onsuccess=e=>res(e.target.result); req.onerror=()=>rej(req.error);
  });
}
async function dbGet(key) {
  try { const db=await openDB(); return new Promise((res,rej)=>{ const r=db.transaction(STORE,"readonly").objectStore(STORE).get(key); r.onsuccess=()=>res(r.result); r.onerror=()=>rej(r.error); }); }
  catch(e){return null;}
}
async function dbSet(key,val) {
  try { const db=await openDB(); return new Promise((res,rej)=>{ const tx=db.transaction(STORE,"readwrite"); tx.objectStore(STORE).put(val,key); tx.oncomplete=()=>res(true); tx.onerror=()=>rej(tx.error); }); }
  catch(e){return false;}
}

// ── Data ──
async function loadData() {
  if(window.fbReady){
    try {
      const remote=await window.fbLoad();
      if(remote){
        const local=await loadLocalData();
        if(local&&local.words){
          Object.keys(local.words).forEach(id=>{
            if(remote.words&&remote.words[id]) remote.words[id]=remote.words[id].map(w=>{const lw=local.words[id]&&local.words[id].find(x=>x.id===w.id); return lw?{...w,img:lw.img}:w;});
          });
        }
        await dbSet("fcData",remote); setSyncBadge("ok"); return remote;
      }
    } catch(e){}
  }
  return await loadLocalData();
}
async function loadLocalData() {
  try { const d=await dbGet("fcData"); if(d) return d; } catch(e){}
  try { const s=localStorage.getItem("fcData"); if(s) return JSON.parse(s); } catch(e){}
  return {decks:[],words:{}};
}
async function saveData(d) {
  await dbSet("fcData",d);
  try{localStorage.setItem("fcData",JSON.stringify(d));}catch(e){}
  showToast("✓ Đã lưu");
  if(window.fbReady){ setSyncBadge("syncing"); const ok=await window.fbSave(d); setSyncBadge(ok?"ok":"local"); }
  else setSyncBadge("local");
}
function setSyncBadge(s) {
  const el=document.getElementById("syncBadge"); if(!el) return;
  if(s==="ok")      {el.style.background="var(--teal-l)";  el.style.color="var(--teal-d)";  el.textContent="☁️ Đã đồng bộ";}
  if(s==="syncing") {el.style.background="var(--amber-l)"; el.style.color="var(--amber-d)"; el.textContent="⏳ Đang lưu...";}
  if(s==="local")   {el.style.background="var(--coral-l)"; el.style.color="var(--coral-d)"; el.textContent="📱 Lưu cục bộ";}
}
window.addEventListener("fbReady",async()=>{ setSyncBadge("syncing"); await loadData(); setSyncBadge("ok"); renderHome(); });

// ── Toast ──
let toastTimer;
function showToast(msg) {
  const el=document.getElementById("toast"); el.textContent=msg; el.classList.add("show");
  clearTimeout(toastTimer); toastTimer=setTimeout(()=>el.classList.remove("show"),1800);
}

// ── Seed ──
async function seedDefault() {
  const d=await loadData();
  if(d.decks.length===0){
    const id="deck_default";
    d.decks.push({id,name:"Hiệu Chuẩn & Quan Trắc",emoji:"⚙️",color:"teal"});
    d.words[id]=[
      {id:"w1",en:"Calibration",ph:"/ˌkælɪˈbreɪʃən/",vn:"Hiệu chuẩn",ex:"Annual calibration is required.",img:null},
      {id:"w2",en:"Accuracy",ph:"/ˈækjərəsi/",vn:"Độ chính xác",ex:"This device has ±0.1% accuracy.",img:null},
      {id:"w3",en:"Uncertainty",ph:"/ʌnˈsɜːtənti/",vn:"Độ không đảm bảo đo",ex:"Report the measurement uncertainty.",img:null},
      {id:"w4",en:"Traceability",ph:"/ˌtreɪsəˈbɪlɪti/",vn:"Liên kết chuẩn",ex:"Traceability to national standards.",img:null},
      {id:"w5",en:"Tolerance",ph:"/ˈtɒlərəns/",vn:"Dung sai",ex:"The reading is within tolerance.",img:null},
      {id:"w6",en:"Drift",ph:"/drɪft/",vn:"Độ trôi",ex:"Sensor drift occurs over time.",img:null},
      {id:"w7",en:"Sensor",ph:"/ˈsɛnsər/",vn:"Cảm biến",ex:"Install the temperature sensor first.",img:null},
      {id:"w8",en:"Humidity",ph:"/hjuːˈmɪdɪti/",vn:"Độ ẩm",ex:"Humidity is measured in percent.",img:null},
    ];
    await saveData(d);
  }
}

// ── PWA Install ──
let deferredPrompt=null;
window.addEventListener("beforeinstallprompt",e=>{ e.preventDefault(); deferredPrompt=e; showInstallBanner(); });
function showInstallBanner() {
  if(localStorage.getItem("installDismissed")) return;
  const banner=document.getElementById("installBanner");
  const hint=document.getElementById("installHint");
  const isIOS=/iphone|ipad|ipod/i.test(navigator.userAgent);
  if(isIOS){hint.textContent='Nhấn nút Chia sẻ ⬆ → "Thêm vào Màn hình chính"'; banner.style.display="block";}
  else if(deferredPrompt){
    hint.textContent="Cài app để dùng offline, nhanh hơn trình duyệt";
    banner.style.display="block";
    banner.querySelector(".install-banner").style.cursor="pointer";
    banner.querySelector(".install-banner").onclick=async e=>{ if(e.target.classList.contains("install-close")) return; deferredPrompt.prompt(); const{outcome}=await deferredPrompt.userChoice; if(outcome==="accepted") dismissInstall(); };
  } else {
    const isSafari=/safari/i.test(navigator.userAgent)&&!/chrome/i.test(navigator.userAgent);
    if(isSafari){hint.textContent='Nhấn nút Chia sẻ ⬆ → "Thêm vào Màn hình chính"'; banner.style.display="block";}
  }
}
function dismissInstall() { localStorage.setItem("installDismissed","1"); document.getElementById("installBanner").style.display="none"; }

// ── State ──
let currentPage="home", editingDeckId=null, selectedColor="teal";
let activeDeckId=null, editingWordId=null;
let studyQueue=[], studyIdx=0, flipped=false;
let knowSet=new Set(), againSet=new Set();
let currentImageData=null;

// ── Image ──
function handleImageUpload(e) {
  const file=e.target.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=ev=>{ const img=new Image(); img.onload=()=>{ const canvas=document.createElement("canvas"); const MAX=400; let w=img.width,h=img.height; if(w>MAX||h>MAX){if(w>h){h=Math.round(h*MAX/w);w=MAX;}else{w=Math.round(w*MAX/h);h=MAX;}} canvas.width=w;canvas.height=h; canvas.getContext("2d").drawImage(img,0,0,w,h); currentImageData=canvas.toDataURL("image/jpeg",.75); document.getElementById("imgPreview").src=currentImageData; document.getElementById("imgPreview").style.display="block"; document.getElementById("imgHint").style.display="none"; document.getElementById("imgClearBtn").style.display="flex"; }; img.src=ev.target.result; };
  reader.readAsDataURL(file);
}
function clearImage() { currentImageData=null; document.getElementById("imgPreview").style.display="none"; document.getElementById("imgHint").style.display="block"; document.getElementById("imgClearBtn").style.display="none"; document.getElementById("imgFile").value=""; }
function resetImageUI() { currentImageData=null; document.getElementById("imgPreview").src=""; clearImage(); }

// ── Pages ──
function showPage(p) {
  document.querySelectorAll(".page").forEach(el=>el.classList.remove("active"));
