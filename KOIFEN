<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getFirestore, doc, getDoc, setDoc } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
const firebaseConfig = {
  apiKey: "AIzaSyC3vfRImSklD8uTSFDPDvOMQehbGYwMBHI",
  authDomain: "koifapp.firebaseapp.com",
  projectId: "koifapp",
  storageBucket: "koifapp.firebasestorage.app",
  messagingSenderId: "871683053677",
  appId: "1:871683053677:web:cd5c8f66a6b91940ae4764"
};
const app = initializeApp(firebaseConfig);
const db = getFirestore(app);
function getDeviceId() {
  let id = localStorage.getItem("koif_device_id");
  if (!id) { id = "device_" + Date.now() + "_" + Math.random().toString(36).slice(2,9); localStorage.setItem("koif_device_id", id); }
  return id;
}
window.fbLoad = async function() {
  try { const snap = await getDoc(doc(db,"users",getDeviceId())); return snap.exists() ? snap.data().appData||null : null; }
  catch(e) { return null; }
};
window.fbSave = async function(data) {
  try {
    const d2 = JSON.parse(JSON.stringify(data));
    if (d2.words) Object.keys(d2.words).forEach(id => { d2.words[id] = d2.words[id].map(w=>({...w,img:null})); });
    await setDoc(doc(db,"users",getDeviceId()), { appData:d2, updatedAt:new Date().toISOString() });
    return true;
  } catch(e) { return false; }
};
window.fbReady = true;
window.dispatchEvent(new Event("fbReady"));
</script>

