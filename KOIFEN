// ── Fill-in-blank helpers ──
let fillChecked = false;

function submitFill() {
  if (fillChecked) return;
  fillChecked = true;
  const w     = studyQueue[studyIdx];
  const ans   = (studyDir==='en' ? w.vn : w.en).trim().toLowerCase();
  const input = document.getElementById('fillInput');
  const userAns = (input.value||'').trim().toLowerCase();
  const fb      = document.getElementById('fillFeedback');
  const rev     = document.getElementById('fillReveal');
  const actRow  = document.getElementById('actionRow');

  // fuzzy: allow 1-char typo for words >4 chars
  const isCorrect = userAns === ans || (ans.length > 4 && levenshtein(userAns, ans) <= 1);

  input.classList.add(isCorrect ? 'correct' : 'wrong');
  fb.style.display = 'block';
  fb.className = 'fill-feedback ' + (isCorrect ? 'correct-fb' : 'wrong-fb');
  fb.textContent = isCorrect ? '🎉 Chính xác!' : '❌ Chưa đúng!';
  rev.style.display = 'block';
  rev.innerHTML = `Đáp án đúng: <strong>${studyDir==='en' ? w.vn : w.en}</strong>${w.ph ? ' <span style="color:var(--muted);font-size:12px">'+w.ph+'</span>' : ''}`;
  actRow.classList.add('vis');
}

function useFillHint(letter, btn) {
  const input = document.getElementById('fillInput');
  if (!input) return;
  input.value = (input.value || '') + letter;
  btn.classList.add('used');
  input.focus();
}

function levenshtein(a, b) {
  const m=a.length, n=b.length;
  const dp=Array.from({length:m+1},(_,i)=>[i,...Array(n).fill(0)]);
  for(let j=0;j<=n;j++) dp[0][j]=j;
  for(let i=1;i<=m;i++) for(let j=1;j<=n;j++) dp[i][j]=a[i-1]===b[j-1]?dp[i-1][j-1]:1+Math.min(dp[i-1][j],dp[i][j-1],dp[i-1][j-1]);
  return dp[m][n];
}

function shuffleLetters(str) {
  // take letters from answer + 2-3 decoys
  const letters = str.toLowerCase().replace(/\s/g,'').split('');
  const decoys  = 'abcdefghijklmnoprstuvwxyz'.split('').filter(c=>!letters.includes(c));
  const extras  = decoys.sort(()=>Math.random()-.5).slice(0, Math.min(3, Math.max(0, 8-letters.length)));
  return shuffle([...letters, ...extras]);
}

// ── Study ──
function shuffle(a) { for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];} return a; }
async function startStudy(deckId) {
  const d=await loadData();
  const deck=d.decks.find(dk=>dk.id===deckId);
  const words=d.words[deckId]||[];
  if(words.length===0){showToast("⚠️ Bộ thẻ chưa có từ nào!"); return;}
  activeDeckId=deckId;
  const prog=d.progress&&d.progress[deckId];
  const s=loadSettings();
  if(prog&&prog.knowIds&&prog.knowIds.length>0&&s.askResume!==false){
    const resume=confirm(`Bạn đã học ${prog.knowIds.length} từ lần trước.\nTiếp tục hay học lại từ đầu?`);
    if(resume){
      const remaining=words.filter(w=>!prog.knowIds.includes(w.id));
      if(remaining.length===0){ if(confirm("Bạn đã biết hết! 🎉 Học lại từ đầu không?")){ clearProgress(deckId); studyQueue=shuffle([...words]); }else return; }
      else { studyQueue=shuffle(remaining); knowSet=new Set(prog.knowIds); againSet=new Set(prog.againIds||[]); }
    } else { clearProgress(deckId); studyQueue=shuffle([...words]); knowSet.clear(); againSet.clear(); }
  } else { studyQueue=shuffle([...words]); knowSet.clear(); againSet.clear(); }
  studyIdx=0; flipped=false; fillChecked=false;
  // sync mode buttons
  document.getElementById('modeFlash').classList.toggle('active', studyMode==='flash');
  document.getElementById('modeFill').classList.toggle('active',  studyMode==='fill');
  document.getElementById('dirEN').classList.toggle('active', studyDir==='en');
  document.getElementById('dirVI').classList.toggle('active', studyDir==='vi');
  const c=COLORS.find(c=>c.name===deck.color)||COLORS[0];
  document.getElementById("progFill").style.background=c.bg;
  document.getElementById("studyTitle").textContent=deck.emoji+" "+deck.name;
  showPage("study"); animateStudyStart(); updateStudyUI(); renderStudyCard();
}
async function saveProgress() {
  const d=await loadData(); if(!d.progress) d.progress={};
  d.progress[activeDeckId]={knowIds:[...knowSet],againIds:[...againSet],savedAt:new Date().toISOString()};
  await saveData(d);
}
async function clearProgress(deckId) {
  const d=await loadData(); if(d.progress) delete d.progress[deckId];
  await saveData(d); knowSet.clear(); againSet.clear();
}
function updateStudyUI() {
  const total=studyQueue.length, done=studyIdx;
  const pct=total?Math.round((done/total)*100):0;
  document.getElementById("progLabel").textContent=`Thẻ ${Math.min(done+1,total)} / ${total}`;
  document.getElementById("progPct").textContent=pct+"%";
  document.getElementById("progFill").style.width=pct+"%";
  document.getElementById("sKnow").textContent=knowSet.size;
  document.getElementById("sAgain").textContent=againSet.size;
  document.getElementById("sLeft").textContent=Math.max(0,total-done);
}
async function renderStudyCard() {
  const area   = document.getElementById("studyArea");
  fillChecked  = false;

  if (studyIdx >= studyQueue.length) {
    document.getElementById("flipWrap").style.display = "none";
    document.getElementById("actionRow").classList.remove("vis");
    const d2=await loadData(); const allWords=d2.words[activeDeckId]||[];
    const allDone=allWords.every(w=>knowSet.has(w.id));
    if(allDone) clearProgress(activeDeckId); else saveProgress();
    const total2=allWords.length; const pct2=total2?Math.round(knowSet.size/total2*100):0;
    const stars=pct2>=90?3:pct2>=60?2:1;
    const starStr="⭐".repeat(stars)+(stars<3?"☆".repeat(3-stars):"");
    launchCelebration(allDone);
    area.innerHTML=`<div class="done-box">
      <span class="done-trophy">${allDone?"🏆":"🎉"}</span>
      <span class="done-stars">${[...starStr].map(s=>`<span class="done-star">${s}</span>`).join("")}</span>
      <h2>${allDone?"Hoàn hảo! 🌟":"Làm tốt lắm!"}</h2>
      <p>${allDone?"Bạn đã biết hết tất cả từ!":"Tiếp tục luyện tập để ghi nhớ tốt hơn nhé."}</p>
      <div class="done-stats">
        <div class="done-stat"><div class="done-stat-num" style="color:var(--teal)">${knowSet.size}</div><div class="done-stat-label">Đã biết</div></div>
        <div class="done-stat"><div class="done-stat-num" style="color:var(--coral)">${againSet.size}</div><div class="done-stat-label">Cần ôn</div></div>
        <div class="done-stat"><div class="done-stat-num">${pct2}%</div><div class="done-stat-label">Hoàn thành</div></div>
      </div>
      <div class="done-btns">
        <button class="btn btn-primary" onclick="startStudy('${activeDeckId}')">Học lại</button>
        <button class="btn btn-secondary" onclick="goHome()">Về trang chủ</button>
      </div>
    </div>`;
    return;
  }

  const w   = studyQueue[studyIdx]; flipped = false;
  const d   = await loadData();
  const deck= d.decks.find(dk=>dk.id===activeDeckId);
  const c   = COLORS.find(c=>c.name===(deck?deck.color:"teal"))||COLORS[0];
  const s   = loadSettings();
  const showPh = s.phonetic!==false;

  // Reset controls
  document.getElementById("actionRow").classList.remove("vis");

  // What to SHOW on front, what to GUESS
  const frontText = studyDir==='en' ? w.en : w.vn;
  const backText  = studyDir==='en' ? w.vn : w.en;
  const frontLabel= studyDir==='en' ? '🇬🇧 Tiếng Anh' : '🇻🇳 Tiếng Việt';
  const backLabel = studyDir==='en' ? '🇻🇳 Nghĩa'      : '🇬🇧 Đáp án';
  const phEl      = w.ph&&showPh&&studyDir==='en' ? `<div class="card-ph">${w.ph}</div>` : '';
  const imgEl     = w.img ? `<img class="card-img" src="${w.img}" alt="">` : '';
  const exEl      = w.ex  ? `<div class="card-ex">"${w.ex}"</div>`        : '';

  // ── FLASH MODE ──
  if (studyMode === 'flash') {
    const fw = document.getElementById("flipWrap");
    fw.style.display = "flex";
    fw.querySelector('.flip-btn').textContent = `↕ Nhấn để xem ${studyDir==='en'?'nghĩa':'từ gốc'}`;
    area.innerHTML=`<div class="card-stage" id="cardStage">
      <div class="card-inner" id="cardInner">
        <div class="card-face card-front">
          <div class="card-badge" style="background:${c.light};color:${c.dark}">${frontLabel}</div>
          <div class="card-num">${studyIdx+1}/${studyQueue.length}</div>
          ${imgEl}
          <div class="card-word">${frontText}</div>${phEl}
        </div>
        <div class="card-face card-back" style="background:${c.bg}">
          <div class="card-badge" style="background:rgba(255,255,255,.2);color:#fff">${backLabel}</div>
          <div class="card-vn">${backText}</div>${exEl}
        </div>
      </div>
    </div>`;
    // Must attach AFTER innerHTML is set
    document.getElementById("cardStage").onclick = flipCard;
    document.getElementById("flipWrap").querySelector('.flip-btn').onclick = flipCard;
  }

  // ── FILL-IN-THE-BLANK MODE ──
  else {
    document.getElementById("flipWrap").style.display = "none";
    const answer = backText.trim();
    // Build scrambled hint letters (only for short answers ≤ 12 chars, no spaces)
    const showLetters = answer.replace(/\s/g,'').length <= 14;
    const letterBtns  = showLetters
      ? shuffleLetters(answer).map(l =>
          `<button class="hint-letter" onclick="useFillHint('${l}',this)">${l}</button>`
        ).join('')
      : '';

    area.innerHTML=`<div class="fill-card">
      <div class="fill-prompt-label">${frontLabel} — đọc và điền nghĩa ${studyDir==='en'?'🇻🇳':'🇬🇧'}</div>
      <div class="fill-prompt">${frontText}${phEl?'<br><span style="font-size:13px;color:var(--muted);font-weight:600">'+w.ph+'</span>':''}</div>
      ${imgEl ? `<div style="display:flex;justify-content:center;margin-bottom:14px">${imgEl}</div>` : ''}
      ${showLetters ? `<div class="hint-letters">${letterBtns}</div>` : ''}
      <div class="fill-input-wrap">
        <input id="fillInput" class="fill-input" placeholder="Nhập đáp án..." autocomplete="off" autocorrect="off" spellcheck="false"
          onkeydown="if(event.key==='Enter')submitFill()">
        <button class="fill-submit" onclick="submitFill()">➤</button>
      </div>
      <div id="fillFeedback" class="fill-feedback"></div>
      <div id="fillReveal"   class="fill-answer-reveal"></div>
      ${w.ex?`<div style="font-size:12px;color:var(--muted);font-weight:600;text-align:center;font-style:italic;margin-top:6px">"${w.ex}"</div>`:''}
    </div>`;
    setTimeout(()=>{ const inp=document.getElementById('fillInput'); if(inp) inp.focus(); },100);
  }
  updateStudyUI();
}
function flipCard() {
  if (flipped) return;
  const inner = document.getElementById("cardInner");
  if (!inner) return;
  flipped = true;
  const s = loadSettings();
  if (s.anim !== false) inner.classList.add("flipped");
  else inner.style.transform = "rotateY(180deg)";
  document.getElementById("flipWrap").style.display  = "none";
  document.getElementById("actionRow").classList.add("vis");
}
async function markKnow() {
  knowSet.add(studyQueue[studyIdx].id);
  againSet.delete(studyQueue[studyIdx].id);
  recordStat('correct');
  studyIdx++; flipped = false; fillChecked = false;
  renderStudyCard();
}
async function markAgain() {
  againSet.add(studyQueue[studyIdx].id);
  recordStat('wrong');
  studyIdx++; flipped = false; fillChecked = false;
  renderStudyCard();
}

// ── STATS TRACKING ──
function todayKey() { return new Date().toISOString().slice(0,10); }

function recordStat(result) {
  // result: 'correct' | 'wrong'
  try {
    const key = 'koif_stats';
    const all = JSON.parse(localStorage.getItem(key)||'{}');
    const day = todayKey();
    if (!all[day]) all[day] = {correct:0, wrong:0};
    all[day][result]++;
    localStorage.setItem(key, JSON.stringify(all));
  } catch(e) {}
}

function getAllStats() {
  try { return JSON.parse(localStorage.getItem('koif_stats')||'{}'); }
  catch(e) { return {}; }
}

async function renderStats() {
  const stats  = getAllStats();
  const today  = todayKey();
  const data   = await loadData();

  // ── TODAY ──
  const td = stats[today]||{correct:0,wrong:0};
  const tdTotal = td.correct + td.wrong;
  document.getElementById('todayStudied').textContent = tdTotal;
  document.getElementById('todayCorrect').textContent = td.correct;
  document.getElementById('todayWrong').textContent   = td.wrong;
  document.getElementById('todayRate').textContent    = tdTotal ? Math.round(td.correct/tdTotal*100)+'%' : '—';

  // ── STREAK ──
  const days = Object.keys(stats).sort();
  let streak = 0, totalDays = days.length;
  if (days.length) {
    let cur = new Date(today); streak = 0;
    while (true) {
      const k = cur.toISOString().slice(0,10);
      if (stats[k] && (stats[k].correct+stats[k].wrong)>0) { streak++; cur.setDate(cur.getDate()-1); }
      else break;
    }
  }
  document.getElementById('streakDays').textContent = streak;
  document.getElementById('totalDays').textContent  = totalDays;

  // ── TOTALS ──
  let totC=0, totW=0;
  Object.values(stats).forEach(d=>{ totC+=d.correct||0; totW+=d.wrong||0; });
  const totAll = totC+totW;
  document.getElementById('totalStudied').textContent = totAll;
  document.getElementById('totalCorrect').textContent = totC;
  document.getElementById('totalWrong').textContent   = totW;
  document.getElementById('totalRate').textContent    = totAll ? Math.round(totC/totAll*100)+'%' : '—';

  // ── 7-DAY BAR CHART ──
  const chart = document.getElementById('weekBarChart');
  const last7 = [];
  for (let i=6;i>=0;i--) { const d=new Date(); d.setDate(d.getDate()-i); last7.push(d.toISOString().slice(0,10)); }
  const maxVal = Math.max(1, ...last7.map(k=>{ const d=stats[k]||{}; return (d.correct||0)+(d.wrong||0); }));
  const days7  = ['T2','T3','T4','T5','T6','T7','CN','T2','T3','T4','T5','T6','T7','CN'];
  chart.innerHTML = last7.map((k,i)=>{
    const dd = stats[k]||{correct:0,wrong:0};
    const total = dd.correct+dd.wrong;
    const hC = Math.round((dd.correct/maxVal)*72);
    const hW = Math.round((dd.wrong/maxVal)*72);
    const dow = new Date(k).getDay(); // 0=Sun
    const lbl = ['CN','T2','T3','T4','T5','T6','T7'][dow];
    const isToday = k===today;
    return `<div class="bar-col" title="${k}: ${total} từ">
      <div style="display:flex;flex-direction:column;justify-content:flex-end;height:72px;gap:1px">
        ${dd.wrong  ? `<div class="bar-fill" style="height:${hW}px;background:var(--coral);opacity:.8"></div>` : ''}
        ${dd.correct? `<div class="bar-fill" style="height:${hC}px;background:var(--accent)"></div>` : ''}
        ${!total    ? `<div class="bar-fill" style="height:3px;background:var(--border)"></div>` : ''}
      </div>
      <div class="bar-lbl" style="color:${isToday?'var(--accent)':'var(--muted)'};font-weight:${isToday?900:700}">${lbl}</div>
    </div>`;
  }).join('');

  // ── DECK PROGRESS ──
  const dpList = document.getElementById('deckProgressList');
  dpList.innerHTML = '';
  if (!data.decks.length) { dpList.innerHTML='<div style="color:var(--muted);font-size:13px;font-weight:700">Chưa có bộ thẻ nào</div>'; }
  data.decks.forEach(deck=>{
    const words   = data.words[deck.id]||[];
    const prog    = data.progress&&data.progress[deck.id];
    const known   = prog?(prog.knowIds||[]).length:0;
    const total   = words.length;
    const pct     = total?Math.round(known/total*100):0;
    const c       = COLORS.find(x=>x.name===deck.color)||COLORS[0];
    dpList.innerHTML += `<div>
      <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:800;margin-bottom:5px">
        <span>${deck.emoji} ${deck.name}</span>
        <span style="color:${c.bg}">${known}/${total} (${pct}%)</span>
      </div>
      <div style="height:8px;background:var(--border);border-radius:6px;overflow:hidden">
        <div style="height:100%;width:${pct}%;background:${c.bg};border-radius:6px;transition:width .5s"></div>
      </div>
    </div>`;
  });

  // ── HEATMAP (90 days) ──
  const hmap = document.getElementById('heatmapGrid');
  const cells90 = [];
  for (let i=89;i>=0;i--) { const d=new Date(); d.setDate(d.getDate()-i); cells90.push(d.toISOString().slice(0,10)); }
  const maxH = Math.max(1,...cells90.map(k=>{ const d=stats[k]||{}; return (d.correct||0)+(d.wrong||0); }));
  // group into weeks
  const weeks = [];
  let week = [];
  // pad start
  const firstDow = new Date(cells90[0]).getDay();
  for (let i=0;i<firstDow;i++) week.push(null);
  cells90.forEach(k=>{ week.push(k); if(week.length===7){weeks.push(week);week=[];} });
  if(week.length) weeks.push(week);

  hmap.innerHTML = weeks.map(w=>`<div class="heatmap-row">${
    w.map(k=>{
      if(!k) return `<div class="heatmap-cell" style="background:transparent"></div>`;
      const dd=stats[k]||{}; const n=(dd.correct||0)+(dd.wrong||0);
      const intensity = n===0?0:Math.ceil((n/maxH)*3);
      const colors=['var(--border)','color-mix(in srgb,var(--accent) 30%,transparent)','color-mix(in srgb,var(--accent) 60%,transparent)','var(--accent)'];
      const isToday=k===today;
      return `<div class="heatmap-cell" style="background:${colors[intensity]};${isToday?'outline:2px solid var(--accent);outline-offset:1px':''}" title="${k}: ${n} từ"></div>`;
    }).join('')
  }</div>`).join('');

  // ── RETENTION TABLE ──
  const periods = [
    {lbl:'Hôm nay',    days:0},
    {lbl:'7 ngày',     days:7},
    {lbl:'30 ngày',    days:30},
    {lbl:'Tất cả',     days:9999},
  ];
  const tbody = document.getElementById('retentionTable');
  tbody.innerHTML = periods.map(p=>{
    const cutoff = new Date(); cutoff.setDate(cutoff.getDate()-p.days);
    let c=0,w=0;
    Object.entries(stats).forEach(([k,v])=>{
      if(p.days===0 && k!==today) return;
      if(p.days!==0 && p.days!==9999 && new Date(k)<cutoff) return;
      c+=v.correct||0; w+=v.wrong||0;
    });
    const tot=c+w;
    const rate=tot?Math.round(c/tot*100):null;
    const cls=rate===null?'':rate>=80?'ret-good':'ret-bad';
    return `<tr>
      <td style="font-weight:800">${p.lbl}</td>
      <td>${tot||'—'}</td>
      <td class="ret-good">${c||'—'}</td>
      <td class="${cls}">${rate!==null?rate+'%':'—'}</td>
    </tr>`;
  }).join('');
}

// ── Settings ──
