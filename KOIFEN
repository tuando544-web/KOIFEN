<style>
/* =============================================
   KOIF – Vibrant Dark Design System
   ============================================= */
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap');

:root {
  --bg:      #111318;
  --card:    #1A1D24;
  --card2:   #22262F;
  --text:    #EEF0F5;
  --muted:   #6B7280;
  --border:  #2A2E38;
  --shadow:  0 2px 12px rgba(0,0,0,0.4);
  --shadow-md: 0 6px 28px rgba(0,0,0,0.5);

  /* Accent – cyan-teal vibrant */
  --accent:    #00D4AA;
  --accent-l:  rgba(0,212,170,0.12);
  --accent-d:  #00A882;

  --teal:   #00D4AA; --teal-l:  rgba(0,212,170,0.15); --teal-d:  #00A882;
  --purple: #A78BFA; --purple-l:rgba(167,139,250,0.15); --purple-d:#7C3AED;
  --blue:   #60A5FA; --blue-l:  rgba(96,165,250,0.15);  --blue-d:  #2563EB;
  --amber:  #FBBF24; --amber-l: rgba(251,191,36,0.15);  --amber-d: #D97706;
  --coral:  #F87171; --coral-l: rgba(248,113,113,0.15); --coral-d: #DC2626;
  --pink:   #F472B6; --pink-l:  rgba(244,114,182,0.15); --pink-d:  #DB2777;
  --green:  #4ADE80; --green-l: rgba(74,222,128,0.15);  --green-d: #16A34A;

  --r:   10px;
  --r-lg: 14px;
  --font: 'Outfit', 'Nunito', -apple-system, BlinkMacSystemFont, sans-serif;
  --bnav: 60px;
}

/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  min-height: -webkit-fill-available;
  overscroll-behavior: none;
}

/* ── SPLASH ── */
#splash {
  position: fixed; inset: 0; z-index: 9999;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 8px;
  background: var(--bg);
  transition: opacity .45s ease, transform .45s ease;
}
#splash.hide { opacity: 0; transform: scale(1.06); pointer-events: none; }
.splash-logo-wrap {
  width: 96px; height: 96px; border-radius: 28px;
  background: var(--accent-l);
  border: 2px solid var(--accent);
  display: flex; align-items: center; justify-content: center;
  font-size: 52px; margin-bottom: 8px;
  animation: splashPop .7s cubic-bezier(.34,1.56,.64,1) both;
  box-shadow: 0 0 40px rgba(0,212,170,0.3);
}
.splash-name {
  font-size: 36px; font-weight: 900; color: var(--accent); letter-spacing: -1px;
  animation: splashUp .5s .2s ease both; opacity: 0;
}
.splash-sub {
  font-size: 14px; color: var(--muted); font-weight: 600;
  animation: splashUp .5s .35s ease both; opacity: 0;
}
.splash-dots {
  display: flex; gap: 6px; margin-top: 40px;
  animation: splashUp .5s .5s ease both; opacity: 0;
}
.splash-dots span {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--accent);
  animation: dotBounce 1s .6s infinite;
}
.splash-dots span:nth-child(2) { animation-delay: .75s; }
.splash-dots span:nth-child(3) { animation-delay: .9s; }
@keyframes splashPop  { from{opacity:0;transform:scale(.3) rotate(-15deg)} 70%{transform:scale(1.1)} to{opacity:1;transform:scale(1)} }
@keyframes splashUp   { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:none} }
@keyframes dotBounce  { 0%,80%,100%{transform:translateY(0)} 40%{transform:translateY(-8px)} }

/* ── TOP HEADER ── */
.header {
  position: sticky; top: 0; z-index: 100;
  background: var(--card);
  border-bottom: 1px solid var(--border);
  padding: 0 16px;
  padding-top: env(safe-area-inset-top, 0px);
  display: flex; align-items: center; gap: 10px;
  height: calc(54px + env(safe-area-inset-top, 0px));
}
.header-logo {
  font-size: 20px; font-weight: 900; letter-spacing: -0.5px;
  color: var(--text); line-height: 1; flex: 1;
}
.header-logo .k { color: var(--accent); }
.header-logo .oif { color: var(--text); }

.sync-badge {
  font-size: 11px; font-weight: 700; padding: 4px 10px;
  border-radius: 20px; white-space: nowrap;
  transition: all .3s;
}

/* ── BOTTOM NAV ── */
.bnav {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 100;
  height: calc(var(--bnav) + env(safe-area-inset-bottom, 0px));
  background: var(--card);
  border-top: 1px solid var(--border);
  display: flex; align-items: flex-start;
  padding-top: 6px;
  max-width: 640px; margin: 0 auto;
}
/* center on desktop */
@media (min-width: 640px) {
  .bnav { left: 50%; transform: translateX(-50%); }
}
.bnav-btn {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; gap: 3px; padding: 6px 0;
  border: none; background: none; cursor: pointer;
  color: var(--muted); font-family: var(--font);
  transition: color .15s;
}
.bnav-btn svg { width: 24px; height: 24px; stroke-width: 2; }
.bnav-btn span { font-size: 10px; font-weight: 700; }
.bnav-btn.active { color: var(--accent); }
.bnav-btn.active svg { filter: drop-shadow(0 0 6px rgba(0,212,170,0.5)); }

/* ── PAGES ── */
.page {
  display: none; padding: 0;
  max-width: 640px; margin: 0 auto;
  padding-bottom: calc(var(--bnav) + env(safe-area-inset-bottom, 0px) + 16px);
  animation: pageIn .25s ease both;
}
.page.active { display: block; }
@keyframes pageIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:none} }

/* ── SECTION HEADER ── */
.section-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 16px 10px;
}
.section-title {
  font-size: 18px; font-weight: 800; color: var(--text); letter-spacing: -0.3px;
}
.section-sub { font-size: 12px; color: var(--muted); font-weight: 500; margin-top: 2px; }

/* ── STREAK / HERO BANNER ── */
.hero-banner {
  margin: 12px 16px 0;
  background: linear-gradient(135deg, rgba(0,212,170,0.15) 0%, rgba(96,165,250,0.1) 100%);
  border: 1px solid rgba(0,212,170,0.25);
  border-radius: var(--r-lg);
  padding: 16px;
  display: flex; align-items: center; gap: 14px;
}
.hero-icon { font-size: 40px; flex-shrink: 0; }
.hero-text h2 { font-size: 16px; font-weight: 800; color: var(--text); margin-bottom: 3px; }
.hero-text p  { font-size: 12px; color: var(--muted); font-weight: 500; }
.hero-stats   { display: flex; gap: 8px; margin-top: 8px; }
.hero-stat {
  background: var(--card2); border: 1px solid var(--border); border-radius: 8px;
  padding: 3px 10px; font-size: 12px; color: var(--accent); font-weight: 700;
}

/* ── INSTALL BANNER ── */
.install-banner {
  margin: 12px 16px 0;
  background: var(--card2); border-radius: var(--r-lg);
  border: 1px solid var(--border);
  padding: 12px 16px;
  display: flex; align-items: center; gap: 12px;
}
.install-banner-icon { font-size: 28px; flex-shrink: 0; }
.install-banner-text strong { font-size: 13px; font-weight: 700; display: block; margin-bottom: 2px; }
.install-banner-text small  { font-size: 11px; color: var(--muted); font-weight: 500; line-height: 1.4; display: block; }
.install-close {
  width: 26px; height: 26px; border-radius: 50%; border: none;
  background: var(--border); color: var(--muted);
  cursor: pointer; font-size: 11px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font);
}

/* ── DECK GRID (Home) — Anki-style table ── */
.deck-grid {
  padding: 4px 16px 0;
  display: flex; flex-direction: column; gap: 0;
}

/* Anki-style table header */
.deck-table-header {
  display: grid;
  grid-template-columns: 1fr 48px 48px 68px;
  padding: 6px 14px;
  font-size: 11px; font-weight: 700; color: var(--muted);
  text-transform: uppercase; letter-spacing: .05em;
  border-bottom: 1px solid var(--border);
}
.deck-table-header span:not(:first-child) { text-align: center; }

/* Anki-style deck row */
.deck-card {
  background: transparent;
  border-bottom: 1px solid var(--border);
  padding: 11px 14px;
  display: grid;
  grid-template-columns: 1fr 48px 48px 68px;
  align-items: center;
  cursor: pointer;
  transition: background .12s;
  position: relative;
}
.deck-card:first-child { border-radius: var(--r) var(--r) 0 0; }
.deck-card:last-child { border-radius: 0 0 var(--r) var(--r); border-bottom: none; }
.deck-card:hover { background: var(--card2); }
.deck-card:active { background: rgba(0,212,170,0.06); }

/* Remove old ::after progress bar */
.deck-card::after { display: none; }

.deck-card-name {
  display: flex; align-items: center; gap: 10px;
}
.deck-icon {
  width: 32px; height: 32px; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; flex-shrink: 0;
}
.deck-body { flex: 1; min-width: 0; }
.deck-name {
  font-size: 14px; font-weight: 600; color: var(--text);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.deck-meta { font-size: 11px; color: var(--muted); font-weight: 500; margin-top: 1px; }
.deck-prog-wrap { display: none; }
.deck-col {
  text-align: center; font-size: 13px; font-weight: 700; color: var(--muted);
}
.deck-col.due { color: #4ADE80; font-weight: 700; }
.deck-col.due.overdue { color: #F87171; }
.deck-col.due.zero { color: var(--muted); }
.deck-know-badge { display: none; }
.deck-chevron { display: none; }

/* The deck table wrapper */
.deck-table-wrap {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  overflow: hidden;
  margin: 0;
}

/* ── MANAGE PAGE DECK CARD ── */
.manage-deck-card {
  background: var(--card2);
  border-radius: var(--r-lg);
  border: 1px solid var(--border);
  padding: 12px 14px;
  display: flex; align-items: center; gap: 12px;
  transition: background .12s;
}
.manage-deck-card:active { background: rgba(0,212,170,0.06); }
.manage-deck-actions { display: flex; gap: 6px; flex-shrink: 0; }
.icon-btn {
  width: 34px; height: 34px; border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--card); cursor: pointer; font-size: 14px;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font); transition: all .15s;
}
.icon-btn:active { background: var(--accent-l); border-color: var(--accent); }

/* ADD DECK BTN */
.add-deck-btn {
  margin: 10px 16px 0;
  width: calc(100% - 32px);
  padding: 14px; border-radius: var(--r-lg);
  border: 1px dashed var(--border);
  background: transparent; font-family: var(--font);
  font-size: 14px; font-weight: 700; color: var(--muted);
  cursor: pointer; transition: all .15s;
  display: flex; align-items: center; justify-content: center; gap: 8px;
}
.add-deck-btn:hover, .add-deck-btn:active {
  border-color: var(--accent); color: var(--accent);
  background: var(--accent-l);
}

/* ── BACKUP SECTION ── */
.backup-section {
  margin: 12px 16px 0;
  background: var(--card); border-radius: var(--r-lg);
  border: 1px solid var(--border);
  padding: 14px; box-shadow: var(--shadow);
}
.backup-title {
  font-size: 12px; font-weight: 700; color: var(--muted);
  text-transform: uppercase; letter-spacing: .06em;
  margin-bottom: 12px; display: flex; align-items: center; gap: 6px;
}
.backup-btns { display: flex; gap: 8px; }
.backup-btn {
  flex: 1; padding: 10px 8px; border-radius: 10px;
  border: none; font-family: var(--font);
  font-size: 13px; font-weight: 700; cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  transition: opacity .15s;
}
.backup-btn:active { opacity: .7; }
.backup-export { background: var(--teal-l);   color: var(--teal); border: 1px solid rgba(0,212,170,0.3); }
.backup-import { background: var(--blue-l);   color: var(--blue); border: 1px solid rgba(96,165,250,0.3); }
.backup-info { font-size: 11px; color: var(--muted); margin-top: 10px; line-height: 1.5; }
#importFile { display: none; }

/* ── MODALS ── */
.overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,0.7); z-index: 200;
  align-items: flex-end; justify-content: center;
}
.overlay.open { display: flex; animation: overlayIn .2s ease; }
@keyframes overlayIn { from{opacity:0} to{opacity:1} }

.modal {
  background: var(--card);
  border-radius: 20px 20px 0 0;
  border-top: 1px solid var(--border);
  padding: 8px 20px calc(20px + env(safe-area-inset-bottom, 0px));
  width: 100%; max-width: 640px;
  max-height: 90vh; overflow-y: auto;
  animation: sheetUp .3s cubic-bezier(.34,1.1,.64,1) both;
}
@keyframes sheetUp { from{transform:translateY(100%)} to{transform:none} }

.modal-handle {
  width: 36px; height: 4px; border-radius: 4px;
  background: var(--border); margin: 10px auto 16px;
}
.modal-title { font-size: 17px; font-weight: 800; margin-bottom: 16px; }

/* ── FORM ELEMENTS ── */
.form-group { margin-bottom: 14px; }
.form-label {
  font-size: 11px; font-weight: 700; color: var(--muted);
  text-transform: uppercase; letter-spacing: .06em;
  display: block; margin-bottom: 6px;
}
.form-input {
  width: 100%; padding: 11px 14px;
  border-radius: 10px; border: 1px solid var(--border);
  background: var(--card2); font-family: var(--font);
  font-size: 14px; font-weight: 500; color: var(--text);
  outline: none; transition: border-color .15s, box-shadow .15s;
}
.form-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(0,212,170,0.15);
}
.form-input::placeholder { color: var(--muted); }

/* Color picker */
.color-row { display: flex; gap: 8px; flex-wrap: wrap; }
.color-dot {
  width: 32px; height: 32px; border-radius: 50%;
  cursor: pointer; border: 2px solid transparent;
  transition: transform .15s, box-shadow .15s;
  position: relative;
}
.color-dot.selected {
  border-color: var(--text); transform: scale(1.15);
  box-shadow: 0 2px 8px rgba(0,0,0,.3);
}
.color-dot.selected::after {
  content: '✓'; position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 13px; font-weight: 800;
}

/* Buttons */
.modal-btns { display: flex; gap: 8px; margin-top: 4px; }
.btn {
  flex: 1; padding: 13px; border-radius: 12px;
  font-family: var(--font); font-size: 14px; font-weight: 700;
  cursor: pointer; border: none; transition: transform .1s, opacity .15s;
}
.btn:active { transform: scale(.96); opacity: .85; }
.btn-primary   { background: var(--accent); color: #111318; box-shadow: 0 4px 14px rgba(0,212,170,0.3); }
.btn-secondary { background: var(--card2); color: var(--text); border: 1px solid var(--border); }
.btn-danger    { background: rgba(248,113,113,0.15); color: var(--coral); border: 1px solid rgba(248,113,113,0.3); }

/* ── IMAGE UPLOAD ── */
.img-upload-area {
  border: 1px dashed var(--border); border-radius: 12px;
  padding: 16px; text-align: center; cursor: pointer;
  transition: all .15s; position: relative; overflow: hidden;
  background: var(--card2);
}
.img-upload-area:hover { border-color: var(--accent); background: var(--accent-l); }
.img-preview { width:100%; max-height:180px; object-fit:cover; border-radius:8px; display:none; }
.img-upload-hint { font-size:12px; color:var(--muted); font-weight:600; }
.img-upload-hint span { font-size:28px; display:block; margin-bottom:6px; }
.img-clear-btn {
  position:absolute; top:10px; right:10px; width:26px; height:26px;
  background:rgba(0,0,0,.6); color:#fff; border:none; border-radius:50%;
  cursor:pointer; font-size:12px; display:none;
  align-items:center; justify-content:center; z-index:2;
}
#imgFile { display:none; }

/* ── WORD LIST ── */
.word-list { display:flex; flex-direction:column; gap:6px; margin-bottom:8px; }
.word-item {
  background:var(--card2); border-radius:10px;
  border:1px solid var(--border);
  padding:9px 12px; display:flex; align-items:center; gap:10px;
}
.word-thumb {
  width:40px; height:40px; border-radius:8px; flex-shrink:0;
  background:var(--card); border:1px solid var(--border);
  display:flex; align-items:center; justify-content:center;
  font-size:18px; overflow:hidden;
}
.word-thumb img { width:100%; height:100%; object-fit:cover; }
.word-body { flex:1; min-width:0; }
.word-en { font-size:13px; font-weight:700; margin-bottom:2px; }
.word-vn { font-size:11px; color:var(--muted); font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.word-actions { display:flex; gap:5px; }

/* ── STUDY PAGE ── */
#page-study { padding-bottom: 16px; }
.study-topbar {
  padding: 12px 16px;
  display: flex; align-items: center; gap: 12px;
}
.back-btn {
  width: 38px; height: 38px; border-radius: 10px;
  border: 1px solid var(--border); background: var(--card2);
  cursor: pointer; font-size: 18px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  transition: all .15s; color: var(--text);
}
.back-btn:active { background: var(--border); }
.study-deck-name { font-size: 14px; font-weight: 700; flex: 1; }

/* Progress bar */
.prog-wrap { padding: 0 16px 12px; }
.prog-track {
  height: 6px; background: var(--border); border-radius: 6px; overflow: hidden;
}
.prog-fill { height: 100%; border-radius: 6px; transition: width .4s ease; background: var(--accent); }
.prog-meta { display:flex; justify-content:space-between; font-size:11px; color:var(--muted); font-weight:600; margin-bottom:5px; }

/* Score pills */
.score-row { display:flex; gap:6px; padding: 0 16px 12px; }
.score-pill {
  font-size:12px; font-weight:700; padding:5px 12px;
  border-radius:20px; display:flex; align-items:center; gap:4px;
}

/* Flashcard */
.card-stage {
  margin: 0 16px 12px;
  perspective: 1000px;
  height: 250px; cursor: pointer; user-select: none;
  animation: cardIn .35s cubic-bezier(.34,1.2,.64,1) both;
}
@keyframes cardIn { from{opacity:0;transform:scale(.88) translateY(16px)} to{opacity:1;transform:none} }

.card-inner {
  width: 100%; height: 100%; position: relative;
  transform-style: preserve-3d;
  transition: transform .5s cubic-bezier(.4,0,.2,1);
}
.card-inner.flipped { transform: rotateY(180deg); }

.card-face {
  position: absolute; inset: 0;
  border-radius: 16px;
  backface-visibility: hidden; -webkit-backface-visibility: hidden;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 22px;
  box-shadow: 0 4px 24px rgba(0,0,0,.3), 0 0 0 1px var(--border);
  overflow: hidden;
}
.card-front { background: var(--card2); }
.card-back {
  transform: rotateY(180deg);
  color: #fff;
}

.card-badge {
  position: absolute; top: 12px; left: 12px;
  font-size: 10px; font-weight: 700; letter-spacing: .06em;
  text-transform: uppercase; padding: 3px 10px; border-radius: 20px;
}
.card-num { position: absolute; top: 12px; right: 12px; font-size: 11px; color: var(--muted); font-weight: 600; }
.card-img {
  width: 64px; height: 64px; border-radius: 12px;
  object-fit: cover; margin-bottom: 10px;
  box-shadow: 0 4px 12px rgba(0,0,0,.3);
}
.card-word { font-size: 26px; font-weight: 800; text-align: center; margin-bottom: 6px; line-height: 1.2; }
.card-ph { font-size: 12px; color: var(--muted); text-align: center; font-weight: 500; }
.card-hint { position: absolute; bottom: 12px; font-size: 11px; color: var(--muted); font-weight: 600; }
.card-vn { font-size: 20px; font-weight: 800; text-align: center; margin-bottom: 8px; line-height: 1.3; }
.card-ex { font-size: 12px; text-align: center; line-height: 1.6; font-style: italic; opacity: .75; font-weight: 500; }

/* ── STUDY MODE SELECTOR ── */
.study-mode-bar {
  display: flex; gap: 6px; padding: 0 16px 12px;
  overflow-x: auto; scrollbar-width: none;
}
.study-mode-bar::-webkit-scrollbar { display: none; }
.mode-btn {
  flex-shrink: 0; padding: 7px 14px; border-radius: 20px;
  border: 1px solid var(--border); background: var(--card2);
  font-family: var(--font); font-size: 12px; font-weight: 700;
  color: var(--muted); cursor: pointer; transition: all .15s;
  display: flex; align-items: center; gap: 6px;
}
.mode-btn.active {
  background: var(--accent); border-color: var(--accent);
  color: #111318; box-shadow: 0 2px 10px rgba(0,212,170,0.3);
}

/* ── DIRECTION TOGGLE ── */
.dir-toggle {
  display: flex; align-items: center; gap: 8px;
  padding: 0 16px 10px;
}
.dir-label { font-size: 11px; font-weight: 700; color: var(--muted); }
.dir-btn {
  display: flex; align-items: center; gap: 6px;
  padding: 6px 12px; border-radius: 20px;
  border: 1px solid var(--border); background: var(--card2);
  font-family: var(--font); font-size: 12px; font-weight: 700;
  color: var(--muted); cursor: pointer; transition: all .15s;
}
.dir-btn.active { border-color: var(--accent); color: var(--accent); background: var(--accent-l); }
.dir-sep { color: var(--border); font-size: 14px; }

/* ── FILL-IN-THE-BLANK ── */
.fill-card {
  margin: 0 16px 12px;
  background: var(--card2); border-radius: 16px;
  border: 1px solid var(--border);
  padding: 24px 18px 18px;
  box-shadow: 0 4px 24px rgba(0,0,0,.3);
  animation: cardIn .35s cubic-bezier(.34,1.2,.64,1) both;
}
.fill-prompt-label {
  font-size: 10px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .08em; color: var(--muted); margin-bottom: 10px;
}
.fill-prompt {
  font-size: 18px; font-weight: 800; line-height: 1.5;
  color: var(--text); margin-bottom: 18px; text-align: center;
}
.fill-prompt .blank {
  display: inline-block; min-width: 80px; border-bottom: 2px solid var(--accent);
  color: var(--accent); padding: 0 4px; font-weight: 800;
}
.fill-hint { font-size: 12px; color: var(--muted); font-weight: 500; text-align: center; margin-bottom: 16px; }

.fill-input-wrap {
  display: flex; gap: 8px; margin-bottom: 12px;
}
.fill-input {
  flex: 1; padding: 12px 14px; border-radius: 12px;
  border: 1px solid var(--border); background: var(--card);
  font-family: var(--font); font-size: 16px; font-weight: 600;
  color: var(--text); outline: none; transition: border-color .15s, box-shadow .15s;
}
.fill-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(0,212,170,0.15);
}
.fill-input.correct { border-color: var(--teal); background: var(--teal-l); color: var(--teal); }
.fill-input.wrong   { border-color: var(--coral); background: var(--coral-l); color: var(--coral); }

.fill-submit {
  padding: 12px 18px; border-radius: 12px;
  background: var(--accent); border: none; color: #111318;
  font-family: var(--font); font-size: 14px; font-weight: 700;
  cursor: pointer; transition: all .15s; flex-shrink: 0;
}
.fill-submit:active { transform: scale(.95); }

.fill-feedback {
  border-radius: 12px; padding: 12px 14px;
  font-size: 14px; font-weight: 700; text-align: center;
  margin-bottom: 10px; display: none;
}
.fill-feedback.correct-fb { background: var(--teal-l);  color: var(--teal); }
.fill-feedback.wrong-fb   { background: var(--coral-l); color: var(--coral); }

.fill-answer-reveal {
  font-size: 12px; font-weight: 600; color: var(--muted);
  text-align: center; margin-bottom: 10px; display: none;
}
.fill-answer-reveal strong { color: var(--text); font-size: 15px; }

/* hint letters */
.hint-letters {
  display: flex; gap: 5px; justify-content: center;
  flex-wrap: wrap; margin-bottom: 14px;
}
.hint-letter {
  width: 32px; height: 40px; border-radius: 8px;
  border: 1px solid var(--border); background: var(--card);
  display: flex; align-items: center; justify-content: center;
  font-size: 15px; font-weight: 800; color: var(--muted);
  cursor: pointer; transition: all .15s; user-select: none;
  font-family: var(--font);
}
.hint-letter:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-l); }
.hint-letter.used  { opacity: .3; pointer-events: none; }

/* Flip button */
.flip-wrap { display:flex; justify-content:center; padding: 0 16px 8px; }
.flip-btn {
  font-family:var(--font); font-size:13px; font-weight:700;
  background:var(--card2); border:1px solid var(--border);
  color:var(--muted); padding:10px 24px; border-radius:12px; cursor:pointer;
  transition: all .15s;
}
.flip-btn:hover { border-color:var(--accent); color:var(--accent); }

/* Action row */
.action-row {
  display:flex; gap:8px; padding: 0 16px;
  opacity:0; pointer-events:none;
  transform:translateY(8px); transition: all .2s;
}
.action-row.vis { opacity:1; pointer-events:all; transform:none; }
.act-btn {
  flex:1; padding:14px; border-radius:14px;
  font-family:var(--font); font-size:14px; font-weight:700;
  border:none; cursor:pointer; transition: transform .1s, opacity .15s;
  display: flex; align-items: center; justify-content: center; gap: 6px;
}
.act-btn:active { transform: scale(.95); }
.btn-again { background: var(--coral-l); color: var(--coral); border: 1px solid rgba(248,113,113,0.3); }
.btn-know  { background: var(--teal-l);  color: var(--teal);  border: 1px solid rgba(0,212,170,0.3); }

/* Done box */
.done-box {
  margin: 0 16px;
  background: var(--card2); border-radius: 18px;
  border: 1px solid var(--border);
  padding: 28px 18px; text-align: center;
  box-shadow: var(--shadow-md);
  animation: cardIn .5s cubic-bezier(.34,1.2,.64,1) both;
}
.done-trophy { font-size: 60px; display: block; margin-bottom: 8px; animation: trophyPop .6s .15s cubic-bezier(.34,1.56,.64,1) both; opacity: 0; }
@keyframes trophyPop { from{opacity:0;transform:scale(.2) rotate(-20deg)} to{opacity:1;transform:scale(1)} }
.done-stars  { font-size: 28px; letter-spacing: 4px; margin-bottom: 10px; display: block; }
.done-star   { display: inline-block; animation: starPop .4s cubic-bezier(.34,1.56,.64,1) both; opacity: 0; }
.done-star:nth-child(1){animation-delay:.35s} .done-star:nth-child(2){animation-delay:.5s} .done-star:nth-child(3){animation-delay:.65s}
@keyframes starPop { from{opacity:0;transform:scale(0)} to{opacity:1;transform:scale(1)} }
.done-box h2 { font-size: 20px; font-weight: 800; margin-bottom: 6px; }
.done-box p  { color: var(--muted); font-size: 13px; font-weight: 500; line-height: 1.6; margin-bottom: 18px; }
.done-stats  { display:flex; gap:8px; justify-content:center; margin-bottom:18px; }
.done-stat   { background:var(--card); border-radius:12px; border:1px solid var(--border); padding:8px 18px; }
.done-stat-num   { font-size:22px; font-weight:800; }
.done-stat-label { font-size:10px; color:var(--muted); font-weight:700; text-transform:uppercase; margin-top:2px; }
.done-btns { display:flex; flex-direction:column; gap:8px; }

/* ── STATS PAGE ── */
.stats-grid {
  padding: 10px 16px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
@media (max-width: 400px) { .stats-grid { grid-template-columns: 1fr; } }

.stat-card {
  background: var(--card); border-radius: var(--r-lg);
  border: 1px solid var(--border); padding: 14px;
  box-shadow: var(--shadow);
}
.stat-card.full { grid-column: span 2; }
.stat-card-title {
  font-size: 12px; font-weight: 700; color: var(--text);
  margin-bottom: 4px;
}
.stat-card-sub {
  font-size: 11px; color: var(--muted); font-weight: 500;
  margin-bottom: 12px;
}

/* big numbers */
.stat-big { font-size: 34px; font-weight: 800; line-height: 1; margin-bottom: 4px; }
.stat-label { font-size: 11px; color: var(--muted); font-weight: 600; }

/* today row */
.today-row { display: flex; gap: 6px; margin-bottom: 10px; }
.today-pill {
  flex: 1; background: var(--card2); border-radius: 10px;
  border: 1px solid var(--border); padding: 8px 6px;
  text-align: center;
}
.today-pill .num  { font-size: 20px; font-weight: 800; }
.today-pill .lbl  { font-size: 10px; color: var(--muted); font-weight: 700; text-transform: uppercase; }

/* bar chart */
.bar-chart { display: flex; align-items: flex-end; gap: 3px; height: 70px; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; }
.bar-fill {
  width: 100%; border-radius: 3px 3px 0 0;
  min-height: 2px; transition: height .4s ease;
}
.bar-lbl { font-size: 9px; color: var(--muted); font-weight: 600; white-space: nowrap; }

/* pie / donut */
.donut-wrap { display: flex; align-items: center; gap: 14px; margin-top: 8px; }
.donut-svg { flex-shrink: 0; }
.donut-legend { flex: 1; display: flex; flex-direction: column; gap: 5px; }
.legend-row { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; }
.legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.legend-pct { margin-left: auto; color: var(--muted); }

/* heatmap calendar */
.heatmap { display: flex; flex-direction: column; gap: 3px; margin-top: 8px; overflow-x: auto; }
.heatmap-row { display: flex; gap: 3px; }
.heatmap-cell {
  width: 13px; height: 13px; border-radius: 2px;
  flex-shrink: 0;
}
.heatmap-months { display: flex; gap: 3px; margin-bottom: 2px; }
.heatmap-month-lbl { font-size: 9px; color: var(--muted); font-weight: 600; }

/* streak */
.streak-row { display: flex; gap: 10px; align-items: center; margin-top: 8px; }
.streak-fire { font-size: 30px; }
.streak-info .big { font-size: 26px; font-weight: 800; }
.streak-info .sub { font-size: 11px; color: var(--muted); font-weight: 600; }

/* retention table */
.ret-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 12px; }
.ret-table th { color: var(--muted); font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 6px; text-align: left; border-bottom: 1px solid var(--border); }
.ret-table td { padding: 6px 6px; font-weight: 600; border-bottom: 1px solid var(--border); }
.ret-table tr:last-child td { border-bottom: none; }
.ret-good { color: var(--teal); }
.ret-bad  { color: var(--coral); }

/* period tabs */
.period-tabs { display: flex; gap: 4px; margin-bottom: 10px; }
.period-tab {
  padding: 4px 10px; border-radius: 14px; border: none;
  font-family: var(--font); font-size: 11px; font-weight: 700;
  cursor: pointer; background: var(--card2); color: var(--muted); transition: all .15s;
}
.period-tab.active { background: var(--accent); color: #111318; }

/* ── SETTINGS PAGE ── */
.settings-section {
  margin: 10px 16px 0;
  background:var(--card); border-radius:var(--r-lg);
  border:1px solid var(--border);
  padding:14px; box-shadow:var(--shadow);
}
.settings-section-title {
  font-size:11px; font-weight:700; color:var(--muted);
  text-transform:uppercase; letter-spacing:.06em; margin-bottom:12px;
}
.theme-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
.theme-btn {
  border-radius:12px; padding:10px 6px; border:2px solid transparent;
  cursor:pointer; text-align:center; font-family:var(--font); transition:all .15s;
}
.theme-btn.selected { border-color:var(--accent); }
.theme-preview { width:100%; height:32px; border-radius:7px; margin-bottom:5px; display:flex; align-items:center; justify-content:center; gap:4px; }
.theme-name { font-size:11px; font-weight:700; }
.accent-grid { display:flex; gap:8px; flex-wrap:wrap; }
.accent-btn {
  width:36px; height:36px; border-radius:50%;
  border:3px solid transparent; cursor:pointer; transition:transform .15s;
  position: relative;
}
.accent-btn.selected { border-color:var(--text); transform:scale(1.15); }
.accent-btn.selected::after { content:'✓'; position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:#fff; font-size:13px; font-weight:800; }
.font-grid { display:flex; flex-direction:column; gap:6px; }
.font-btn {
  padding:10px 12px; border-radius:10px; border:1px solid var(--border);
  background:var(--card2); cursor:pointer; text-align:left; transition:all .15s;
  font-family: var(--font);
}
.font-btn.selected { border-color:var(--accent); background:var(--accent-l); }
.font-btn .font-name { font-size:13px; font-weight:700; color:var(--text); }
.font-btn .font-sample { font-size:11px; color:var(--muted); margin-top:2px; font-weight:500; }
.settings-row {
  display:flex; align-items:center; justify-content:space-between;
  padding:11px 0; border-bottom:1px solid var(--border);
}
.settings-row:last-child { border-bottom:none; padding-bottom:0; }
.settings-row-label { font-size:13px; font-weight:700; }
.settings-row-sub   { font-size:11px; color:var(--muted); font-weight:500; margin-top:2px; }
.toggle {
  width:46px; height:26px; border-radius:13px;
  background:var(--border); position:relative;
  cursor:pointer; border:none; transition:background .2s; flex-shrink:0;
}
.toggle.on { background:var(--accent); }
.toggle::after {
  content:''; position:absolute; top:3px; left:3px;
  width:20px; height:20px; border-radius:50%; background:#fff;
  transition:transform .2s; box-shadow:0 1px 4px rgba(0,0,0,.3);
}
.toggle.on::after { transform:translateX(20px); }

/* ── EMPTY STATE ── */
.empty-state { text-align:center; padding:36px 16px; }
.empty-icon  { font-size:48px; margin-bottom:10px; }
.empty-state p { font-size:13px; font-weight:600; color:var(--muted); line-height:1.6; }

/* ── CONFETTI ── */
#celebration { position:fixed; inset:0; z-index:500; pointer-events:none; overflow:hidden; }
.confetti-piece {
  position:absolute; width:10px; height:10px; border-radius:2px;
  animation:confettiFall linear both;
}
@keyframes confettiFall {
  0%  { transform:translateY(-20px) rotate(0deg) scale(1); opacity:1; }
  80% { opacity:1; }
  100%{ transform:translateY(110vh) rotate(720deg) scale(.5); opacity:0; }
}
.firework { position:absolute; width:6px; height:6px; border-radius:50%; animation:fireworkBurst .8s ease-out both; }
@keyframes fireworkBurst { 0%{transform:translate(0,0) scale(1);opacity:1} 100%{opacity:0} }

/* ── TOAST ── */
.toast {
  position:fixed; bottom:calc(var(--bnav) + env(safe-area-inset-bottom,0px) + 12px);
  left:50%; transform:translateX(-50%) translateY(12px);
  background: var(--card); color:var(--text);
  border: 1px solid var(--border);
  padding:9px 18px; border-radius:20px;
  font-size:13px; font-weight:700; opacity:0; transition:all .3s;
  z-index:999; white-space:nowrap; pointer-events:none;
  box-shadow: 0 4px 20px rgba(0,0,0,0.5);
}
.toast.show { opacity:1; transform:translateX(-50%) translateY(0); }

/* ── DESKTOP ── */
@media (min-width: 640px) {
  .page, .header { max-width: 640px; margin: 0 auto; }
  .header { left: 50%; transform: translateX(-50%); position: sticky; }
}
</style>
</head>
