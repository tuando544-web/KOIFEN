  {id:"dark",name:"Tối",bg:"#111318",card:"#1A1D24",text:"#EEF0F5",muted:"#6B7280"},
  {id:"light",name:"Sáng",bg:"#F7F7F7",card:"#FFFFFF",text:"#1C1C1E",muted:"#6E6E73"},
  {id:"warm",name:"Ấm",bg:"#F5F0E8",card:"#FDFAF4",text:"#2C2416",muted:"#7A6E5A"},
];
const ACCENTS=[
  {id:"teal",bg:"#00D4AA",light:"rgba(0,212,170,0.15)",dark:"#00A882"},
  {id:"purple",bg:"#A78BFA",light:"rgba(167,139,250,0.15)",dark:"#7C3AED"},
  {id:"blue",bg:"#60A5FA",light:"rgba(96,165,250,0.15)",dark:"#2563EB"},
