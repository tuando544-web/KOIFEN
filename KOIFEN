async function exportBackup() {
  const d=await loadLocalData();
  const json=JSON.stringify({version:1,exportedAt:new Date().toISOString(),data:d},null,2);
  const blob=new Blob([json],{type:"application/json"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a"); a.href=url; a.download=`koif-backup-${Date.now()}.json`; a.click();
