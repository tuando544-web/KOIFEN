  const s=loadSettings(); const accentId=s.accent||"teal";
  const map={teal:"#00D4AA",purple:"#A78BFA",blue:"#60A5FA",amber:"#FBBF24",coral:"#F87171",pink:"#F472B6",green:"#4ADE80",indigo:"#818CF8"};
