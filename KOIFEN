async function importBackup(e) {
  const file=e.target.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=async ev=>{
    try {
      const json=JSON.parse(ev.target.result);
      const d=json.data||json;
      if(!d.decks) throw new Error("Invalid");
      if(!confirm("Nhập backup sẽ ghi đè dữ liệu hiện tại. Tiếp tục?")) return;
      await saveData(d); renderManage(); updateBackupInfo(); showToast("✅ Nhập backup thành công!");
    } catch(err){ showToast("❌ File không hợp lệ!"); }
  };
  reader.readAsText(file); e.target.value="";
}

